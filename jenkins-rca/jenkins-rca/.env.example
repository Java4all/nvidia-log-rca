# ── LLM model (Ollama) ───────────────────────────────────────────────────────
# Choices for EC2 g6.xlarge (NVIDIA L4, 24 GB VRAM):
#   mistral:7b-instruct-q4_K_M      ~4 GB  fastest
#   llama3.1:8b-instruct-q4_K_M     ~5 GB  best general
#   qwen2.5:14b-instruct-q4_K_M     ~9 GB  best for logs/code  ← recommended
LLM_MODEL=mistral:7b-instruct-q4_K_M

# ── Embedding model ──────────────────────────────────────────────────────────
EMBED_MODEL=nomic-embed-text

# ── Local reranker (HuggingFace cross-encoder, downloaded on first use) ──────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Upload limit (bytes, default 50 MB) ──────────────────────────────────────
MAX_LOG_BYTES=52428800
