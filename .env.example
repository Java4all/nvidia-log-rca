# ── LLM backend ──────────────────────────────────────────────────────────────
# ollama  = local Ollama (default) — needs LLM_MODEL
# nvidia  = ChatNVIDIA (NVIDIA AI / NIM–compatible endpoints) — needs NVIDIA_API_KEY
LLM_BACKEND=ollama

# Ollama chat model (when LLM_BACKEND=ollama)
# EC2 g6.xlarge (24 GB): e.g. qwen2.5:14b-instruct-q4_K_M, llama3.1:8b-instruct-q4_K_M
LLM_MODEL=mistral:7b-instruct-q4_K_M

# When LLM_BACKEND=nvidia — get an API key: see README "NVIDIA API key" or
# https://docs.nvidia.com/nim/large-language-models/latest/getting-started.html#generate-an-api-key
# NVIDIA_API_KEY=nvapi-...
# Default matches upstream GenerativeAIExamples log_analysis_multi_agent_rag
# NVIDIA_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# ── Embedding model (Ollama) — used for FAISS in all modes ──────────────────
EMBED_MODEL=nomic-embed-text

# ── Local reranker (HuggingFace cross-encoder) ───────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── Upload limit (bytes, default 50 MB) ──────────────────────────────────────
MAX_LOG_BYTES=52428800
